# Generated by qprompt-a2a from qprompt graph '{{ ir.graph }}', workflow
# '{{ view.name }}'. DO NOT EDIT BY HAND -- see orchestrator.py's docstring
# for the regenerate command.
#
# build.context is the qprompt monorepo root (computed relative to this
# file at generation time) since the Dockerfiles here COPY sibling source
# trees (qprompt-langgraph, qprompt-a2a) that live outside this generated
# project's own directory.
services:
{% for svc in services %}
  {{ svc.compose_name }}:
    build:
      context: {{ build_context | yaml_str }}
      dockerfile: {{ (out_rel ~ "/Dockerfile.agent") | yaml_str }}
      args:
        SERVICE_NAME: {{ svc.node.name | yaml_str }}
{% if svc.node.agent.kind == 'llm' and svc.node.context_resources %}
        NEEDS_RAG: "true"
{% endif %}
    environment:
      - PORT=8000
      - SELF_URL=http://{{ svc.compose_name }}:8000/
{% if svc.node.agent.kind == 'container' %}
      # See qprompt_langgraph.runtime.workspace_dir's docstring: this
      # service launches sibling tool containers via the shared Docker
      # socket below, so a container-local temp dir isn't visible to the
      # host daemon resolving the bind mount -- HOST_WORKSPACE_DIR/this
      # same host directory mounted at /host-workspace is how it gets a
      # scratch path both sides can see.
      - HOST_WORKSPACE_DIR={{ host_workspace_dirs[svc.compose_name] }}
{% endif %}
{% if svc.node.agent.kind == 'llm' and svc.node.context_resources %}
      - QPROMPT_RAG_ROOT=/rag
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
{% if svc.node.agent.kind == 'container' %}
      - {{ (host_workspace_dirs[svc.compose_name] ~ ":/host-workspace") | yaml_str }}
{% endif %}
{% if svc.node.agent.kind == 'llm' and svc.node.context_resources %}
      # Read-only: this service only ever calls retrieve() (never
      # build_index()) -- indices are built offline via
      # `qprompt-langgraph index`, on the host, before `docker compose up`.
      - {{ (rag_index_host_dir ~ ":/rag:ro") | yaml_str }}
{% endif %}
{% if svc.node.agent.kind == 'llm' %}
    models:
      - {{ svc.node.agent.model }}
{% endif %}
{% if svc.node.secret_env_names %}
    secrets:
{% for name in svc.node.secret_env_names %}
      - {{ name }}
{% endfor %}
{% endif %}
    networks:
      - qprompt

{% endfor %}
  orchestrator:
    build:
      context: {{ build_context | yaml_str }}
      dockerfile: {{ (out_rel ~ "/Dockerfile.orchestrator") | yaml_str }}
    environment:
      - PORT=8000
      # Task outputs (see /run's "task" field) are written here, which is
      # bind-mounted below so they land on the host at the same relative
      # path the .qprompt source's `outputs:` mapping declares (e.g.
      # generated/login.cy.ts ends up at <this project dir>/generated/login.cy.ts).
      - OUTPUT_DIR=/opt/output
{% for svc in services %}
      - {{ svc.env_prefix }}_URL=http://{{ svc.compose_name }}:8000
{% endfor %}
    volumes:
      - {{ (output_host_dir ~ ":/opt/output") | yaml_str }}
    ports:
      - "{{ orchestrator_host_port }}:8000"
    depends_on:
{% for svc in services %}
      - {{ svc.compose_name }}
{% endfor %}
    networks:
      - qprompt

{% if models %}
models:
{% for m in models %}
  {{ m.name }}:
    model: {{ m.model | yaml_str }}
{% if m.context_size %}
    context_size: {{ m.context_size }}
{% endif %}
{% if m.runtime_flags %}
    runtime_flags:
{% for flag in m.runtime_flags %}
      - {{ flag | yaml_str }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

{% if secrets %}
# Each secret's real value is never written to disk in this repo -- set it
# in whatever environment `docker compose up` itself runs in (e.g.
# `JOOBLE_API_KEY=... docker compose up`), and Compose mounts it at
# /run/secrets/<name> for every service listed below, which
# runtime.resolve_secret reads from. See qprompt_langgraph.runtime
# .resolve_secret's docstring for the non-Compose (plain env var) fallback.
secrets:
{% for name in secrets %}
  {{ name }}:
    environment: {{ name }}
{% endfor %}
{% endif %}

networks:
  qprompt: {}
