        state.update(resolve_state_assignments(assignments, {"report": report}))
{% endif %}
{% elif node.agent.kind == 'db' %}
        result = run_query(connection={{ (node.agent.connection or '') | pyrepr }}, query={{ (node.agent.query or '') | pyrepr }}, inputs=inputs)
{% for ch in node.publish %}
