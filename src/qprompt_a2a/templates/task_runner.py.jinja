"""Generated by qprompt-a2a for qprompt task '{{ task.name }}' (workflow:
'{{ task.workflow }}').

DO NOT EDIT BY HAND -- regenerate via:
  qprompt-cli generate <file>.qprompt --format ir
  qprompt-a2a render <file>.ir.json '{{ task.workflow }}'

Thin convenience wrapper only -- the orchestrator's /run endpoint itself
knows this task's default inputs/outputs (see its TASKS dict) and writes
outputs to a real host directory it has mounted, so this script's only job
is `{"task": "{{ task.name }}"}`. Override defaults by calling /run
directly instead of this script, e.g.:

  curl -X POST http://localhost:{{ orchestrator_host_port }}/run -d \
    '{"task": "{{ task.name }}", "inputs": {"given_query": "..."}}'

Uses only the standard library so it needs nothing installed beyond
python3 itself.
"""

from __future__ import annotations

import json
import os
import urllib.request

ORCHESTRATOR_URL = os.environ.get("ORCHESTRATOR_URL", {{ ("http://localhost:" ~ orchestrator_host_port) | pyrepr }})


def main() -> None:
    body = json.dumps({"task": {{ task.name | pyrepr }}}).encode()
    request = urllib.request.Request(
        f"{ORCHESTRATOR_URL}/run",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=600) as response:
        result = json.loads(response.read())

    print(f"failed={result.get('failed')!r}")
    for channel, path in result.get("_written_outputs", {}).items():
        print(f"wrote {channel!r} -> {path}")


if __name__ == "__main__":
    main()
